# Credentials and local configuration
.env
.env.*
!.env.example
*.pem
*.key
id_ed25519*
id_rsa*

# Experiment state must stay outside the source release
/results/
/_preserve/
/experiment_packages/
/docker_vm_data/
/cache/
/logs/
*.qcow2
*.vmdk
*.img
*.iso
*.log

# Python and editor state
.venv/
.venv-*/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage*
htmlcov/
build/
dist/
*.egg-info/
.DS_Store
.idea/
.vscode/

# 忽略宿主机的备份配置
runtime.json.local-original

# 运行产物 / 备份
*.pid
*.bak-*

# 远程运行时代码/配置（.runtime/deepswe 下）随仓库走；
# 密钥、依赖、二进制与运行产物一律排除。
.runtime/*
!.runtime/deepswe/
.runtime/deepswe/*
!.runtime/deepswe/phase3_eval/
!.runtime/deepswe/launchers/
.runtime/deepswe/phase3_eval/*
!.runtime/deepswe/phase3_eval/*.py
!.runtime/deepswe/phase3_eval/*.yaml
.runtime/deepswe/launchers/*
!.runtime/deepswe/launchers/*.sh
