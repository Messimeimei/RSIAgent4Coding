+//! Persisted context policy. Native behavior remains the default for old sessions.
+use serde::{Deserialize, Serialize};
+
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum ContextMode {
+    #[default]
+    Native,
+    FullHistory,
+    WorkLog,
+}
+
+#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(default, deny_unknown_fields)]
+pub struct ContextPolicy {
+    pub mode: ContextMode,
+    pub work_log: WorkLogConfig,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(default, deny_unknown_fields)]
+pub struct WorkLogConfig {
+    pub history_keep_pairs: usize,
+    pub keep_chars: usize,
+    pub ctx_high_water: usize,
+    pub ctx_low_water: usize,
+    pub fold_batch: usize,
+    pub worklog_max_chars: usize,
+}
+
+impl Default for WorkLogConfig {
+    fn default() -> Self {
+        Self {
+            history_keep_pairs: 80,
+            keep_chars: 500_000,
+            ctx_high_water: 900_000,
+            ctx_low_water: 500_000,
+            fold_batch: 10,
+            worklog_max_chars: 500_000,
+        }
+    }
+}
+
+impl ContextPolicy {
+    pub fn validate(&self) -> Result<(), String> {
+        if self.mode == ContextMode::WorkLog {
+            let c = &self.work_log;
+            if c.history_keep_pairs < 6
+                || c.fold_batch == 0
+                || c.worklog_max_chars == 0
+                || c.ctx_low_water == 0
+                || c.ctx_high_water <= c.ctx_low_water
+            {
+                return Err("Invalid work_log policy: keep at least six rounds, use positive batch/log/low-water values and high_water > low_water".into());
+            }
+        }
+        Ok(())
+    }
+
+    /// The recent window is measured in characters, with the reference six-pair floor.
+    pub fn retained_units(&self, content_chars: &[usize]) -> usize {
+        let c = &self.work_log;
+        let mut chars = 0usize;
+        let mut keep = 0usize;
+        for size in content_chars.iter().rev() {
+            if keep >= c.history_keep_pairs
+                || (keep >= 6 && c.keep_chars > 0 && chars.saturating_add(*size) > c.keep_chars)
+            {
+                break;
+            }
+            chars = chars.saturating_add(*size);
+            keep += 1;
+        }
+        keep
+    }
+
+    pub fn strict(&self) -> bool {
+        self.mode != ContextMode::Native
+    }
+
+    pub fn check_capacity(
+        &self,
+        input: usize,
+        window: usize,
+        output: usize,
+        safety: usize,
+    ) -> Result<(), String> {
+        let limit = window.checked_sub(output.saturating_add(safety));
+        if self.strict() && limit.is_none_or(|limit| input > limit) {
+            return Err(format!("context_capacity_exceeded: policy={:?}, input_tokens={}, context_window={}, output_reserve={}, safety_reserve={}; history preserved; no native compression or truncation applied", self.mode, input, window, output, safety));
+        }
+        Ok(())
+    }
+}
+
+/// Stored on the synthetic WORK LOG message so snapshots and forks retain state.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct WorkLogState {
+    pub task: String,
+    pub summary: String,
+    pub folded_units: usize,
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn policy_defaults_and_validation() {
+        assert_eq!(
+            serde_json::from_str::<ContextPolicy>("{}").unwrap().mode,
+            ContextMode::Native
+        );
+        assert!(serde_json::from_str::<ContextPolicy>(r#"{"mode":"ful_history"}"#).is_err());
+        assert!(
+            serde_json::from_str::<ContextPolicy>(r#"{"mode":"full_history","typo":1}"#).is_err()
+        );
+        let mut p = ContextPolicy {
+            mode: ContextMode::WorkLog,
+            ..Default::default()
+        };
+        assert!(p.validate().is_ok());
+        p.work_log.fold_batch = 0;
+        assert!(p.validate().is_err());
+    }
+    #[test]
+    fn keep_window_has_floor_ceiling_and_character_budget() {
+        let p = ContextPolicy {
+            mode: ContextMode::WorkLog,
+            ..Default::default()
+        };
+        assert_eq!(p.retained_units(&vec![100; 100]), 80);
+        assert_eq!(p.retained_units(&vec![100_000; 100]), 6);
+        assert_eq!(p.retained_units(&vec![50_000; 100]), 10);
+        assert_eq!(p.retained_units(&[900_000; 2]), 2);
+    }
+    #[test]
+    fn strict_capacity_reserves_output_and_never_drops_history() {
+        let p = ContextPolicy {
+            mode: ContextMode::FullHistory,
+            ..Default::default()
+        };
+        assert!(p.check_capacity(52_592, 128_128, 65_536, 10_000).is_ok());
+        assert!(p
+            .check_capacity(52_593, 128_128, 65_536, 10_000)
+            .unwrap_err()
+            .contains("history preserved"));
+        assert!(p.check_capacity(1, 100, 101, 0).is_err());
+        assert!(ContextPolicy::default()
+            .check_capacity(999_999, 100, 101, 0)
+            .is_ok());
+    }
+}
