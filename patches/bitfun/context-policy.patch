+//! Reference-style WORK LOG planning over complete assistant/tool exchanges.
+//! One coding exchange maps to one reference action/observation pair. A user
+//! dialog turn can contain hundreds of these exchanges and is not a fold unit.
+use crate::agentic::core::{Message, MessageContent, MessageRole, MessageSemanticKind};
+use bitfun_agent_runtime::context_policy::{ContextPolicy, WorkLogState};
+
+pub const SUMMARIZER_SYSTEM: &str = include_str!("work_log_prompt.txt");
+
+fn content_text(message: &Message) -> String {
+    match &message.content {
+        MessageContent::Text(text) | MessageContent::Multimodal { text, .. } => text.clone(),
+        MessageContent::Mixed {
+            text, tool_calls, ..
+        } => {
+            let mut out = text.clone();
+            for call in tool_calls {
+                out.push_str(&format!("\n{} {}", call.tool_name, call.arguments));
+            }
+            out
+        }
+        MessageContent::ToolResult {
+            result,
+            result_for_assistant,
+            ..
+        } => result_for_assistant
+            .clone()
+            .filter(|s| !s.is_empty())
+            .unwrap_or_else(|| result.to_string()),
+    }
+}
+
+fn reasoning_chars(message: &Message) -> usize {
+    match &message.content {
+        MessageContent::Mixed {
+            reasoning_content: Some(reasoning),
+            ..
+        } => reasoning.chars().count(),
+        _ => 0,
+    }
+}
+
+pub fn rendered_chars(messages: &[Message]) -> usize {
+    messages
+        .iter()
+        .filter(|m| m.role != MessageRole::System)
+        .map(|m| {
+            // The task is independently pinned, matching the reference size trigger.
+            m.metadata.work_log_state.as_ref().map_or_else(
+                || content_text(m).chars().count() + reasoning_chars(m),
+                |state| state.summary.chars().count(),
+            )
+        })
+        .sum()
+}
+
+fn fold_input(text: &str) -> String {
+    let chars: Vec<char> = text.chars().collect();
+    if chars.len() <= 4_000 {
+        return text.to_owned();
+    }
+    format!(
+        "{}\n…[trace middle elided]…\n{}",
+        chars[..1_500].iter().collect::<String>(),
+        chars[chars.len() - 2_500..].iter().collect::<String>()
+    )
+}
+
+pub struct WorkLogPlan {
+    pub task: String,
+    pub previous_summary: String,
+    pub folded_units: usize,
+    pub batch: Vec<Message>,
+    pub tail: Vec<Message>,
+}
+
+impl WorkLogPlan {
+    pub fn request(&self) -> String {
+        let rendered = self
+            .batch
+            .iter()
+            .map(|m| {
+                format!(
+                    "[{}]\n{}",
+                    if m.role == MessageRole::Assistant {
+                        "YOU"
+                    } else {
+                        "ENV"
+                    },
+                    fold_input(&content_text(m))
+                )
+            })
+            .collect::<Vec<_>>()
+            .join("\n\n");
+        format!(
+            "CURRENT LOG:\n{}\n\nOLDER TURNS TO FOLD IN:\n{}\n\nOutput the updated log only.",
+            if self.previous_summary.is_empty() {
+                "(empty)"
+            } else {
+                &self.previous_summary
+            },
+            rendered
+        )
+    }
+
+    pub fn apply(self, raw_summary: &str, cap: usize) -> Vec<Message> {
+        let summary = if raw_summary.trim().is_empty() {
+            // Same starvation fallback as the reference: oldest folded pairs
+            // become explicit digest lines; this is never used for API errors.
+            let digest = self
+                .batch
+                .iter()
+                .map(|m| {
+                    format!(
+                        "[{}] {}",
+                        if m.role == MessageRole::Assistant {
+                            "you"
+                        } else {
+                            "env"
+                        },
+                        content_text(m)
+                            .split_whitespace()
+                            .collect::<Vec<_>>()
+                            .join(" ")
+                            .chars()
+                            .take(220)
+                            .collect::<String>()
+                    )
+                })
+                .collect::<Vec<_>>()
+                .join("\n");
+            let combined = format!("{}\n{}", self.previous_summary, digest);
+            let chars: Vec<char> = combined.chars().collect();
+            if chars.len() > cap {
+                let tail: String = chars[chars.len() - cap..].iter().collect();
+                tail.split_once('\n')
+                    .map_or(tail.clone(), |(_, rest)| rest.to_owned())
+            } else {
+                combined
+            }
+        } else {
+            cap_worklog(raw_summary.trim(), cap)
+        };
+        let content = format!("TASK (verbatim, unchanged — this is the actual goal):\n{}\n\nWORK LOG — your running summary of earlier turns (full details live in the machine; re-probe if you need specifics):\n{}", self.task, summary);
+        let mut message =
+            Message::user(content).with_semantic_kind(MessageSemanticKind::CompressionSummary);
+        message.metadata.work_log_state = Some(WorkLogState {
+            task: self.task,
+            summary,
+            folded_units: self.folded_units,
+        });
+        let mut messages = vec![message];
+        messages.extend(self.tail);
+        messages
+    }
+}
+
+fn cap_worklog(text: &str, cap: usize) -> String {
+    if text.chars().count() <= cap {
+        return text.to_owned();
+    }
+    let prefix: String = text.chars().take(cap).collect();
+    let cut = prefix
+        .rfind('\n')
+        .filter(|i| prefix[..*i].chars().count() >= cap / 2)
+        .unwrap_or(prefix.len());
+    format!("{}\n[... WORK LOG truncated at the char cap — least-important (re-derivable) detail dropped; the machine still holds ground truth, re-probe if needed]", prefix[..cut].trim_end())
+}
+
+/// Returns one oldest complete batch, leaving the protected recent exchanges
+/// and all in-flight user/tool messages intact. Caller owns high/low hysteresis.
+pub fn plan(messages: &[Message], policy: &ContextPolicy) -> Option<WorkLogPlan> {
+    let state = messages
+        .iter()
+        .find_map(|m| m.metadata.work_log_state.clone());
+    let task = state.as_ref().map(|s| s.task.clone()).or_else(|| {
+        messages
+            .iter()
+            .find(|m| m.is_actual_user_message())
+            .map(content_text)
+    })?;
+    let history: Vec<Message> = messages
+        .iter()
+        .filter(|m| m.role != MessageRole::System && m.metadata.work_log_state.is_none())
+        .cloned()
+        .collect();
+    let mut ends = Vec::new();
+    let mut sizes = Vec::new();
+    let mut start = 0;
+    let mut i = 0;
+    while i < history.len() {
+        if history[i].role != MessageRole::Assistant {
+            i += 1;
+            continue;
+        }
+        i += 1;
+        while i < history.len() && history[i].role == MessageRole::Tool {
+            i += 1;
+        }
+        ends.push(i);
+        sizes.push(
+            history[start..i]
+                .iter()
+                .map(|m| content_text(m).chars().count())
+                .sum(),
+        );
+        start = i;
+    }
+    let keep = policy.retained_units(&sizes);
+    let batch = policy.work_log.fold_batch;
+    if ends.len().saturating_sub(keep) < batch {
+        return None;
+    }
+    let cutoff = ends[batch - 1];
+    Some(WorkLogPlan {
+        task,
+        previous_summary: state
+            .as_ref()
+            .map(|s| s.summary.clone())
+            .unwrap_or_default(),
+        folded_units: state.map(|s| s.folded_units).unwrap_or_default() + batch,
+        batch: history[..cutoff].to_vec(),
+        tail: history[cutoff..].to_vec(),
+    })
+}
